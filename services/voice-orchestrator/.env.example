# 「小川」编排服务环境变量样例(plan §16.2:模型与 key 全走环境变量,不落仓)
# 复制为 .env.local(.env.local 已被 .gitignore 忽略)后填写。

# ---- WS hub(安全基线,2026-09-28 审核) ----
#VOICE_HUB_PORT=3210
# 默认只绑 127.0.0.1;跨机部署必须显式放开并自行评估 exposure
#VOICE_HUB_HOST=127.0.0.1
# 跨机模式(VOICE_HUB_HOST 非回环)必须同时设置,各 ≥16 字符且互不相同;回环模式可都留空
#VOICE_HUB_CONSOLE_TOKEN=
#VOICE_HUB_SCREEN_TOKEN=
# Origin 白名单(逗号分隔精确匹配);缺省仅允许本机来源
#VOICE_HUB_ALLOWED_ORIGINS=http://localhost:3015
# 并发连接上限
#VOICE_HUB_MAX_CONNECTIONS=32
# 提问限流:最小间隔 / 滑动窗口 / 窗口内上限
#VOICE_QUESTION_MIN_GAP_MS=1500
#VOICE_QUESTION_WINDOW_MS=60000
#VOICE_QUESTION_WINDOW_MAX=8
# 预取超时(平台接口挂起时该轮走数据源降级)
#VOICE_PREFETCH_TIMEOUT_MS=5000

# ---- 大屏 payload 数据源(B①:迁移平台 = 改这两个值) ----
#VOICE_PAYLOAD_MODE=fixture          # fixture(默认) | http
#VOICE_PAYLOAD_URL=https://platform.example.com
#VOICE_PAYLOAD_PUBLIC_ID=your-public-id

# ---- 本地 LLM（OpenAI 兼容，8c 结构化意图分类） ----
# 留空 VOICE_LLM_API_KEY = 离线 scripted 适配器(演示/验收用)
#VOICE_LLM_BASE_URL=http://127.0.0.1:1234/v1
#VOICE_LLM_API_KEY=
#VOICE_LLM_MODEL=your-loaded-model
#VOICE_LLM_REASONING_EFFORT=none
#VOICE_LLM_TIMEOUT_MS=8000
# 本地无鉴权的兼容服务也须设非空 VOICE_LLM_API_KEY（如 local-placeholder），否则走 scripted

# ---- 平台 MCP（代码保留；8c 分类主路径不执行工具轮） ----
#VOICE_MCP_ENABLED=0
#VOICE_MCP_URL=https://platform.example.com/api/mcp
#VOICE_MCP_API_KEY=
# 工具白名单(逗号分隔;空 = 全部拒绝)。工具名来自 LLM、问题攻击者可控,
# 不能只依赖平台端只读 key
#VOICE_MCP_TOOLS=query_sales_summary,query_region_data

# ---- 打点 ----
#VOICE_TRACE_FILE=logs/voice-trace.jsonl

# ---- 大屏视觉节奏(可调,一般不动) ----
#VOICE_PARTIAL_PACE_MS=45
#VOICE_PARTIAL_MAX_MS=1200

# ---- 8c 本地语音（默认关闭；开启必须同时设置上述双令牌） ----
#VOICE_LOCAL_URL=http://127.0.0.1:8810
#VOICE_TTS_ENABLED=0
#VOICE_TTS_STYLE=default
#VOICE_TTS_CACHE_DIR=

# Browser microphone/KWS configuration (runtime files served by this Site).
VOICE_VAD_HANGOVER_MS=500
VOICE_MIC_REOPEN_DELAY_MS=300
VOICE_BARGE_THRESHOLD=0.8
VOICE_BARGE_MIN_SPEECH_MS=300
VOICE_BARGE_CONFIRM_MS=500
VOICE_VAD_PRE_PAD_MS=500
VOICE_KWS_THRESHOLD=0.25
VOICE_KWS_SCORE=1
VOICE_KWS_ENERGY=0.01
VOICE_WAKE_PHRASE=你好，小川
# JSON intent → configured style override; model never chooses a style.
VOICE_SPEECH_STYLE_MAP={}

# 从实际开麦开始等待；服务端另有缺失回报兜底。
VOICE_LISTEN_TIMEOUT_MS=5000
