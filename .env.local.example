# Copy to .env.local (ignored by Git); fill in locally and restart Next.js.
# Platform origin serving /api/screen/sales/{publicId}; server only.
SCREEN_PLATFORM_URL=
# Existing platform public sales-screen share ID; server only, never NEXT_PUBLIC.
SCREEN_PUBLIC_ID=
# Optional: led-1792x832 (default), 16x9, 4x3. URL ?layout= takes precedence.
SCREEN_LAYOUT=
